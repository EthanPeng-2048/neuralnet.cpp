// ── layernorm.comp ────────────────────────────────────────────────────────
// GPU LayerNorm 计算着色器：output[f][b] = gamma[f] * (input[f][b] - mean[b]) / sqrt(var[b] + eps) + beta[f]
//
// 输入布局（列主序矩阵，row-major 索引 = f * cols + b）：
//   binding 0: input[rows * cols]  — 输入矩阵
//   binding 1: gamma[rows]         — 缩放参数
//   binding 2: beta[rows]          — 偏移参数
//   binding 3: output[rows * cols] — 输出矩阵
//
// Push Constants：
//   uint rows     — 特征维度
//   uint cols     — batch 维度
//   uint eps_bits — epsilon 的 IEEE-754 位表示（float → uint 重解释）
//
// 算法：每个 WorkGroup 处理一列（一个 batch 元素），使用 shared memory 归约。
// ─────────────────────────────────────────────────────────────────────────

#version 450

layout(local_size_x = 256) in;

layout(std430, binding = 0) readonly buffer  BufIn  { float buf_in[];  };
layout(std430, binding = 1) readonly buffer  BufG   { float buf_gamma[]; };
layout(std430, binding = 2) readonly buffer  BufB   { float buf_beta[];  };
layout(std430, binding = 3) writeonly buffer BufOut { float buf_out[]; };

layout(push_constant) uniform PushConstants {
    uint rows;
    uint cols;
    uint eps_bits;
};

shared float sdata[256];

float uint_bits_to_float(uint bits) {
    return uintBitsToFloat(bits);
}

void main()
{
    const float eps = uint_bits_to_float(eps_bits);
    const uint tid = gl_LocalInvocationID.x;   // 0..255
    const uint col = gl_WorkGroupID.x;         // batch 元素索引
    const uint feature_count = rows;

    // ── Phase 1: 计算均值 ───────────────────────────────────────────
    // 每个线程累加多个元素
    float local_sum = 0.0;
    for (uint f = tid; f < feature_count; f += 256u)
    {
        local_sum += buf_in[f * cols + col];
    }
    sdata[tid] = local_sum;
    barrier();

    // Workgroup reduction
    for (uint stride = 128u; stride > 0u; stride >>= 1u)
    {
        if (tid < stride)
            sdata[tid] += sdata[tid + stride];
        barrier();
    }

    const float mean = sdata[0] / float(feature_count);
    barrier();

    // ── Phase 2: 计算方差 ───────────────────────────────────────────
    float local_sq_sum = 0.0;
    for (uint f = tid; f < feature_count; f += 256u)
    {
        float diff = buf_in[f * cols + col] - mean;
        local_sq_sum += diff * diff;
    }
    sdata[tid] = local_sq_sum;
    barrier();

    for (uint stride = 128u; stride > 0u; stride >>= 1u)
    {
        if (tid < stride)
            sdata[tid] += sdata[tid + stride];
        barrier();
    }

    const float inv_std = 1.0 / sqrt(sdata[0] / float(feature_count) + eps);
    barrier();

    // ── Phase 3: 归一化 + 仿射变换 ─────────────────────────────────
    for (uint f = tid; f < feature_count; f += 256u)
    {
        float normalized = (buf_in[f * cols + col] - mean) * inv_std;
        buf_out[f * cols + col] = buf_gamma[f] * normalized + buf_beta[f];
    }
}
