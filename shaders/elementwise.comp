// ── elementwise.comp ──────────────────────────────────────────────────────
// 逐元素运算计算着色器
//
// 支持的操作（通过 push constant 选择）：
//   op=0: ReLU        — max(x, 0)
//   op=1: QuickGeLU   — x * sigmoid(1.702 * x)
//   op=2: BiasAdd     — data[f*cols+b] + bias[f]（广播加法）
//   op=3: ReLU Backward — (input > 0) ? grad : 0  （buf_a=grad, buf_b=input）
//   op=4: Multiply    — a * b（逐元素乘法，buf_a * buf_b）
//   op=5: GeLU Backward — grad * s * (1 + βx(1-s)), s=sigmoid(βx)  （buf_a=grad, buf_b=input）
//
// 绑定布局：
//   binding 0: 主输入
//   binding 1: 次输入（BiasAdd 的 bias，或与 binding 0 相同）
//   binding 2: 输出
//
// Push Constants：
//   uint count  — 元素总数
//   uint op     — 操作码
//   uint rows   — BiasAdd 的行数（特征数），其他操作时为 0
//   uint cols   — BiasAdd 的列数（batch），其他操作时为 0
// ─────────────────────────────────────────────────────────────────────────

#version 450

layout(local_size_x = 256) in;

layout(std430, binding = 0) readonly buffer  BufA   { float buf_a[]; };
layout(std430, binding = 1) readonly buffer  BufB   { float buf_b[]; };
layout(std430, binding = 2) writeonly buffer BufOut { float buf_out[]; };

layout(push_constant) uniform PushConstants {
    uint count;
    uint op;
    uint rows;
    uint cols;
};

void main()
{
    const uint idx = gl_GlobalInvocationID.x;
    if (idx >= count) return;

    if (op == 0u)
    {
        // ── ReLU ──
        buf_out[idx] = max(buf_a[idx], 0.0);
    }
    else if (op == 1u)
    {
        // ── QuickGeLU: x * sigmoid(1.702 * x) ──
        const float x = buf_a[idx];
        const float sig = 1.0 / (1.0 + exp(-1.702 * x));
        buf_out[idx] = x * sig;
    }
    else if (op == 2u)
    {
        // ── BiasAdd: data[f*cols+b] + bias[f] ──
        const uint f = idx / cols;
        buf_out[idx] = buf_a[idx] + buf_b[f];
    }
    else if (op == 3u)
    {
        // ── ReLU Backward: (input > 0) ? grad : 0 ──
        // buf_a = grad_output, buf_b = input
        buf_out[idx] = (buf_b[idx] > 0.0) ? buf_a[idx] : 0.0;
    }
    else if (op == 4u)
    {
        // ── Multiply: a * b ──
        buf_out[idx] = buf_a[idx] * buf_b[idx];
    }
    else if (op == 5u)
    {
        // ── GeLU Backward: grad * s * (1 + β*x*(1 - s)), s = sigmoid(β*x) ──
        // buf_a = grad_output, buf_b = input
        const float x = buf_b[idx];
        const float s = 1.0 / (1.0 + exp(-1.702 * x));
        const float factor = s * (1.0 + 1.702 * x * (1.0 - s));
        buf_out[idx] = buf_a[idx] * factor;
    }
}
