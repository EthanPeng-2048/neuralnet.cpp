// ── bmm_q_backward.comp ───────────────────────────────────────────────────
// 两趟式注意力反向 Pass 1（M6 融合原语，重算 W 不物化得分矩阵）：
//   R[i]      = Σ_j W[i][j]·P[i][j]                       → (batch*M, 1)
//   grad_Q[:,i] = alpha·Σ_j W[i][j]·(P[i][j]-R[i])·B_b[:,j] → (batch*K, M)
// 其中 W[i][j] = exp( alpha·op(A_b,B_b)[i][j] + mask[i][j] - row_max[i] ) / denom[i]
//   A: (batch*K, M)（transA=1 时存储为 (K,M) 按 A_b^T 使用），B: (batch*K, N)
//   P: (batch*M, N)，row_max/denom: (batch*M, 1)，mask（可选）: (M, N)
//   M = 输出行（query），N = 键列，K = d_k
//
// Bindings：A(0), B(1), Mask(2), RowMax(3), Denom(4), P(5), OutR(6), OutGQ(7)
// Push Constants：uint M, uint N, uint K, uint flags, float alpha
//   flags bit0=transA, bit1=transB, bit2=has_mask
// Dispatch：(batch*M, 1, 1)，每个工作组（256 线程）处理一个 query 行
// ─────────────────────────────────────────────────────────────────────────

#version 450

layout(local_size_x = 256) in;

layout(std430, binding = 0) readonly buffer  BufA    { float A[]; };
layout(std430, binding = 1) readonly buffer  BufB    { float B[]; };
layout(std430, binding = 2) readonly buffer  BufMask { float MASK[]; };
layout(std430, binding = 3) readonly buffer  BufM    { float MV[]; };
layout(std430, binding = 4) readonly buffer  BufL    { float LV[]; };
layout(std430, binding = 5) readonly buffer  BufP    { float P[]; };
layout(std430, binding = 6) writeonly buffer BufR    { float OUTR[]; };
layout(std430, binding = 7) writeonly buffer BufGQ   { float OUTGQ[]; };

layout(push_constant) uniform PC {
    uint M;
    uint N;
    uint K;
    uint flags;
    float alpha;
};

shared float w[4096];
shared float sdata[256];

void main()
{
    const float NEG_INF = uintBitsToFloat(0xff800000u);
    const uint tid = gl_LocalInvocationID.x;
    const uint idx = gl_WorkGroupID.x;   // b*M + i
    const uint b = idx / M;
    const uint i = idx % M;
    const uint abase = b * K * M;
    const uint bbase = b * K * N;
    const bool transA = (flags & 1u) != 0u;
    const bool transB = (flags & 2u) != 0u;
    const bool has_mask = (flags & 4u) != 0u;
    const float mval = MV[idx];
    const float inv_l = 1.0 / LV[idx];

    // ── Phase A：计算 W[i][j]（存共享）并累加 R 的部分和 ──
    float acc = 0.0;
    for (uint j = tid; j < N; j += 256u)
    {
        float mv = 0.0;
        if (has_mask)
        {
            mv = MASK[i * N + j];
            if (mv == NEG_INF) { w[j] = 0.0; continue; }
        }
        float s = 0.0;
        for (uint k = 0u; k < K; ++k)
        {
            const float av = transA ? A[abase + k * M + i] : A[abase + i * K + k];
            const float bv = transB ? B[bbase + j * K + k] : B[bbase + k * N + j];
            s += av * bv;
        }
        w[j] = exp(alpha * s + mv - mval) * inv_l;
        acc += w[j] * P[idx * N + j];
    }
    sdata[tid] = acc;
    barrier();
    for (uint st = 128u; st > 0u; st >>= 1u)
    {
        if (tid < st) sdata[tid] += sdata[tid + st];
        barrier();
    }
    const float rval = sdata[0];
    if (tid == 0u) OUTR[idx] = rval;

    // ── Phase B：grad_Q[:,i] = alpha·Σ_j w[j]·(P-R)·B_b[:,j] ──
    for (uint k = tid; k < K; k += 256u)
    {
        float acc2 = 0.0;
        for (uint j = 0u; j < N; ++j)
        {
            const float bv = transB ? B[bbase + j * K + k] : B[bbase + k * N + j];
            acc2 += w[j] * (P[idx * N + j] - rval) * bv;
        }
        OUTGQ[(b * K + k) * M + i] = alpha * acc2;
    }
}
