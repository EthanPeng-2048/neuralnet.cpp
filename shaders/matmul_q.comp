// ── matmul_q.comp — 三值打包权重的量化 GEMM 原语（P2 / F3，**分块版**）──────
// C = (τ∘A)^(T)·B，其中 A 以 2 bit/权重打包（见 trit_pack.comp / ternary_pack.hpp），
// τ 是逐**存储行**的尺度（absmean，乘进每个 trit）。两种形态：
//   transA=0：A 存为 (M,K) 打包 → C (M,N) = (τ∘A)·B，B (K,N)，τ 取存储行 m
//   transA=1：A 存为 (K,M) 打包 → C (M,N) = (τ∘A)^T·B，B (K,N)，τ 取存储行 k
//
// **为什么分块**（实测驱动的重写）：初版是"每输出元素独立解码"的直白内核 ——
// 宽 batch（训练）下同一行被重复解码 N 次，输给分块 f16 GEMM（102/40HX 实测
// 60 步训练 4.0 s vs 2.0 s）。本版把 A 分块**解码一次进共享内存**（BM×BK），
// 之后与 f16 分块 GEMM 同构地累加；打包带来的收益（权重读 2 B → 0.25 B/权重）
// 才可能在宽 batch 下兑现。
//
// 分块参数与 `matmul_tiled.comp` 同款（16×16 线程 / BM=BN=64 / BK=16 / 每线程
// 4×4 / 双缓冲），差别只在一处：**A 分块的装载是"解码"而不是"读 float"**。
// BK=16 恰好 = 一个 32-bit 字装的 trit 数 ⇒ 每个 A 存储行在一个 k 块里只取
// **一个**字（尾部块由 trit 越界判 0 处理，即码 2 = 三值 0）。
//
// 精度变体（glslc -DNN_SHADER_F16=1）：B/C 声明 float16_t（f32 参考累加 + 写出
// RNE，同所有原语惯例）；打包字缓冲恒 uint。
// ─────────────────────────────────────────────────────────────────────────
#version 450

#if defined(NN_SHADER_F16)
#extension GL_EXT_shader_16bit_storage : require
#define NN_ETYPE float16_t
#define NN_V4    uvec2
#define NN_LOADV4(arr, i) vec4(unpackHalf2x16(arr[i].x), unpackHalf2x16(arr[i].y))
#define NN_RD(x) float(x)
#include "nn_f16_rne.glsl"
#define NN_WR(x) float16_t(nn_f16_rne(x))
#else
#define NN_ETYPE float
#define NN_V4    vec4
#define NN_LOADV4(arr, i) arr[i]
#define NN_RD(x) x
#define NN_WR(x) x
#endif

layout(local_size_x = 16, local_size_y = 16) in;

layout(std430, binding = 0) readonly  buffer BufP { uint P[]; };      // 打包 A
layout(std430, binding = 1) readonly  buffer BufT { float T[]; };     // τ（存储行）
layout(std430, binding = 2) readonly  buffer BufB { NN_ETYPE B[]; };  // B (K,N)
layout(std430, binding = 2) readonly  buffer BufBv4 { NN_V4 Bv4[]; };
layout(std430, binding = 3) writeonly buffer BufC { NN_ETYPE C[]; };  // C (M,N)
#if !defined(NN_SHADER_F16)
layout(std430, binding = 3) writeonly buffer BufCv4 { vec4 Cv4[]; };
#endif

layout(push_constant) uniform Push {
    uint M;
    uint N;
    uint K;       // 求和维（= B 的行数）
    uint transA;  // 0 = A 存 (M,K)；1 = A 存 (K,M)
    uint wpr;     // A 每存储行的字数：transA=0 → ceil(K/16)；transA=1 → ceil(M/16)
};

const uint BM = 64u, BN = 64u, BK = 16u;
const uint EPT_A = (BM * BK) / 256u;   // 4
const uint EPT_B = (BK * BN) / 256u;   // 4

// Ash[stage][k][m>>2][m&3]：A^T 分块（与 matmul_tiled 同布局，内层按行连续读）
// Bsh[stage][k][n>>2][n&3]：B 分块
shared vec4 Ash[2][BK][BM / 4];
shared vec4 Bsh[2][BK][BN / 4];

// ── A 分块装载（**解码**）：BM×BK 元素，每线程 4 个 ───────────────────────
// 分组与 matmul_tiled 的 A 装载一致（按连续维取 4 元素组），只是每个元素都
// 由"打包字 → 2 bit 码 → 三值 → ×τ"得到：
//   transA=0：4 个连续 k（同一存储行 m）→ 同一行、k0..k0+3，字内不同 2-bit 槽
//   transA=1：4 个连续 m（同一存储行 k）
void load_A_tile(uint t, uint stage, uint tid, uint block_row)
{
    const uint k_contig = (transA == 0u) ? 1u : 0u;
    const uint groups = EPT_A / 4u;
    for (uint vv = 0u; vv < groups; ++vv)
    {
        const uint g = tid * groups + vv;
        uint sr;      // 存储行
        uint c0;      // 该组第一个"列"（= k 或 m）
        uint cmax;    // 列上限（= K 或 M）
        if (k_contig != 0u)
        {
            const uint m = (4u * g) / BK;
            c0 = t * BK + (4u * g) % BK;
            sr = block_row + m;
            cmax = K;
        }
        else
        {
            const uint mq = g % (BM / 4u);
            const uint k  = g / (BM / 4u);
            c0 = block_row + mq * 4u;     // 列 = m
            sr = t * BK + k;              // 存储行 = k
            cmax = M;
        }
        const float tau = (sr < ((k_contig != 0u) ? M : K)) ? T[sr] : 0.0;
        for (uint j = 0u; j < 4u; ++j)
        {
            const uint cj = c0 + j;
            float v = 0.0;
            if (cj < cmax && sr < ((k_contig != 0u) ? M : K))
            {
                const uint word = P[sr * wpr + (cj >> 4u)];
                v = tau * (float((word >> (2u * (cj & 15u))) & 3u) - 2.0);
            }
            if (k_contig != 0u)
            {
                // 组内 4 个连续 k：k0 = c0 - t*BK
                const uint k0 = c0 - t * BK;
                const uint m = sr - block_row;
                Ash[stage][k0 + j][m >> 2][m & 3u] = v;
            }
            else
            {
                const uint k = sr - t * BK;
                const uint m = cj - block_row;   // 组内 4 个连续 m
                Ash[stage][k][m >> 2][m & 3u] = v;
            }
        }
    }
}

// ── B 分块装载（B 恒为 (K,N) 行主序 = transB=0；与 matmul_tiled 同款）──────
void load_B_tile(uint t, uint stage, uint tid, uint block_col)
{
    const uint b_base_row = t * BK;
    const bool aligned = ((N & 3u) == 0u);
    const uint groups = EPT_B / 4u;
    for (uint vv = 0u; vv < groups; ++vv)
    {
        const uint g = tid * groups + vv;
        const uint k  = (4u * g) / BN;
        const uint n0 = (4u * g) % BN;
        const uint gr = b_base_row + k;
        const uint gc = block_col + n0;
        if (aligned && gr < K && gc < N)
        {
            const vec4 v = NN_LOADV4(Bv4, (gr * N + gc) >> 2);
            for (uint j = 0u; j < 4u; ++j)
                Bsh[stage][k][(n0 + j) >> 2][(n0 + j) & 3u] = v[j];
        }
        else
        {
            for (uint j = 0u; j < 4u; ++j)
            {
                const float v = (gr < K && gc + j < N) ? NN_RD(B[gr * N + gc + j]) : 0.0;
                Bsh[stage][k][(n0 + j) >> 2][(n0 + j) & 3u] = v;
            }
        }
    }
}

void main()
{
    const uint tx = gl_LocalInvocationID.x;
    const uint ty = gl_LocalInvocationID.y;
    const uint tid = ty * 16u + tx;

    const uint block_row = gl_WorkGroupID.y * BM;
    const uint block_col = gl_WorkGroupID.x * BN;

    vec4 acc[4];
    for (uint i = 0u; i < 4u; ++i) acc[i] = vec4(0.0);

    const uint num_tiles = (K + BK - 1u) / BK;
    load_A_tile(0u, 0u, tid, block_row);
    load_B_tile(0u, 0u, tid, block_col);
    barrier();

    uint stage = 0u;
    for (uint t = 0u; t < num_tiles; ++t)
    {
        const uint nxt = t + 1u;
        const uint nstage = stage ^ 1u;
        if (nxt < num_tiles)
        {
            load_A_tile(nxt, nstage, tid, block_row);
            load_B_tile(nxt, nstage, tid, block_col);
        }
        #pragma unroll 4
        for (uint k = 0u; k < BK; ++k)
        {
            const vec4 a_vec = Ash[stage][k][ty];
            const vec4 b_vec = Bsh[stage][k][tx];
            acc[0] += a_vec.x * b_vec;
            acc[1] += a_vec.y * b_vec;
            acc[2] += a_vec.z * b_vec;
            acc[3] += a_vec.w * b_vec;
        }
        barrier();
        stage = nstage;
    }

    // ── 写出（f32 走 vec4 快路径；f16 / 未对齐走标量 RNE）──────────────
#if defined(NN_SHADER_F16)
    // f16 输出：逐标量写出（C 无 vec4 别名视图）
    // ⚠ acc[i] 是**行 i 的 4 个列**（vec4 分量的语义与 f32 快路径一致）——
    // 写成 acc[j][i] 会转置（f32 路径看不出、f16 路径直接错值，实测训练 loss 炸）
    for (uint i = 0u; i < 4u; ++i)
    {
        const uint out_row = block_row + ty * 4u + i;
        if (out_row >= M) continue;
        const uint out_col0 = block_col + tx * 4u;
        if (out_col0 >= N) continue;
        C[out_row * N + out_col0 + 0u] = NN_WR(acc[i].x);
        if (out_col0 + 1u < N) C[out_row * N + out_col0 + 1u] = NN_WR(acc[i].y);
        if (out_col0 + 2u < N) C[out_row * N + out_col0 + 2u] = NN_WR(acc[i].z);
        if (out_col0 + 3u < N) C[out_row * N + out_col0 + 3u] = NN_WR(acc[i].w);
    }
#else
    if ((N & 3u) == 0u && block_col + BN <= N)
    {
        for (uint i = 0u; i < 4u; ++i)
        {
            const uint out_row = block_row + ty * 4u + i;
            if (out_row >= M) continue;
            Cv4[(out_row * N + block_col + tx * 4u) >> 2] = acc[i];
        }
    }
    else
    {
        for (uint i = 0u; i < 4u; ++i)
        {
            const uint out_row = block_row + ty * 4u + i;
            if (out_row >= M) continue;
            for (uint j = 0u; j < 4u; ++j)
            {
                const uint out_col = block_col + tx * 4u + j;
                if (out_col >= N) continue;
                C[out_row * N + out_col] = acc[i][j];
            }
        }
    }
#endif
}
