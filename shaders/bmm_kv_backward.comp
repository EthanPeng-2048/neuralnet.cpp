// ── bmm_kv_backward.comp ──────────────────────────────────────────────────
// 两趟式注意力反向 Pass 2（M6 融合原语，重算 W 不物化得分矩阵）：
//   grad_K[:,j] = alpha·Σ_i W[i][j]·(P[i][j]-R[i])·A_b[:,i]   → (batch*K, N)
//   grad_V[j][k] = Σ_i W[i][j]·G[i][k]                        → (batch*K, N)
// 其中 W[i][j] = exp( alpha·op(A_b,B_b)[i][j] + mask[i][j] - row_max[i] ) / denom[i]
//   A: (batch*K, M)（transA=1 时存储为 (K,M) 按 A_b^T 使用），B: (batch*K, N)
//   P: (batch*M, N)，G: (batch*M, D)，R/row_max/denom: (batch*M, 1)
//   mask（可选）: (M, N)，M = query 数，N = key 数，K = d_k
//
// Bindings：A(0), B(1), Mask(2), RowMax(3), Denom(4), P(5), G(6), R(7),
//           OutV(8), OutK(9)（grad_K 为返回输出，须在最后；grad_V 经 out 参数）
// Push Constants：uint M, uint N, uint K, uint D, uint flags, float alpha
//   flags bit0=transA, bit1=transB, bit2=has_mask
// Dispatch：(batch*N, 1, 1)，每个工作组（256 线程）处理一个 key 列
// ─────────────────────────────────────────────────────────────────────────

#version 450

layout(local_size_x = 256) in;

layout(std430, binding = 0) readonly buffer  BufA    { float A[]; };
layout(std430, binding = 1) readonly buffer  BufB    { float B[]; };
layout(std430, binding = 2) readonly buffer  BufMask { float MASK[]; };
layout(std430, binding = 3) readonly buffer  BufM    { float MV[]; };
layout(std430, binding = 4) readonly buffer  BufL    { float LV[]; };
layout(std430, binding = 5) readonly buffer  BufP    { float P[]; };
layout(std430, binding = 6) readonly buffer  BufG    { float G[]; };
layout(std430, binding = 7) readonly buffer  BufR    { float R[]; };
layout(std430, binding = 8) writeonly buffer BufV    { float OUTV[]; };
layout(std430, binding = 9) writeonly buffer BufK    { float OUTK[]; };

layout(push_constant) uniform PC {
    uint M;
    uint N;
    uint K;
    uint D;
    uint flags;
    float alpha;
};

shared float w[4096];

void main()
{
    const float NEG_INF = uintBitsToFloat(0xff800000u);
    const uint tid = gl_LocalInvocationID.x;
    const uint idx = gl_WorkGroupID.x;   // b*N + j
    const uint b = idx / N;
    const uint j = idx % N;
    const uint abase = b * K * M;
    const uint bbase = b * K * N;
    const bool transA = (flags & 1u) != 0u;
    const bool transB = (flags & 2u) != 0u;
    const bool has_mask = (flags & 4u) != 0u;

    // ── Phase A：计算 W[i][j]（所有 i，存共享）──
    for (uint i = tid; i < M; i += 256u)
    {
        float mv = 0.0;
        if (has_mask)
        {
            mv = MASK[i * N + j];
            if (mv == NEG_INF) { w[i] = 0.0; continue; }
        }
        const uint ri = b * M + i;
        float s = 0.0;
        for (uint k = 0u; k < K; ++k)
        {
            const float av = transA ? A[abase + k * M + i] : A[abase + i * K + k];
            const float bv = transB ? B[bbase + j * K + k] : B[bbase + k * N + j];
            s += av * bv;
        }
        w[i] = exp(alpha * s + mv - MV[ri]) / LV[ri];
    }
    barrier();

    // ── Phase B：grad_K 与 grad_V ──
    for (uint k = tid; k < K; k += 256u)
    {
        float accK = 0.0;
        float accV = 0.0;
        for (uint i = 0u; i < M; ++i)
        {
            const uint ri = b * M + i;
            const float av = transA ? A[abase + k * M + i] : A[abase + i * K + k];
            accK += w[i] * (P[ri * N + j] - R[ri]) * av;
            accV += w[i] * G[ri * D + k];
        }
        OUTK[(b * K + k) * N + j] = alpha * accK;
        OUTV[(b * K + k) * N + j] = accV;
    }
}
