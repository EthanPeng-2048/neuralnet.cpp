// ── batched_matmul.comp ──────────────────────────────────────────────────
// 批量分块矩阵乘法原语：对每个 batch b 计算 C_b = alpha * op(A_b, B_b)
//
// 布局约定：
//   A: (batch * A_rows_per_batch, A_cols) 行主序 — 按 batch 切分为连续行块
//   B: (batch * B_rows_per_batch, B_cols) 行主序
//   C: (batch * M, N) 行主序 — 每个批次结果垂直堆叠
//
// 转置标志（与 matmul.comp 语义一致）：
//   transA=0: A_b 为 (M, K)，A_b[m][k] = A[b*M*K + m*K + k]
//   transA=1: A_b 存储为 (K, M) 按 A_b^T 使用，A_b[m][k] = A[b*M*K + k*M + m]
//   transB=0: B_b 为 (K, N)，B_b[k][n] = B[b*K*N + k*N + n]
//   transB=1: B_b 存储为 (N, K) 按 B_b^T 使用，B_b[k][n] = B[b*K*N + n*K + k]
//
// 优化策略（与 matmul_tiled.comp 相同的寄存器分块方案）：
//   - WorkGroup：16×16 线程，Z 维度索引 batch，计算 64×64 输出块
//   - 寄存器分块：每线程在寄存器中维护 4×4 累加和，大幅提升计算访存比
//   - Shared Memory Padding：17/65 列宽避免 Bank Conflict
//   - alpha 缩放在写出时一次完成（cuBLAS sgemm 语义，供上层折叠
//     1/sqrt(d_k) 等系数，省去额外的全矩阵 scale pass）
//   - Dispatch: (ceil(N/64), ceil(M/64), batch)
//
// 注意：此着色器只包含原语操作（矩阵乘法的批量索引 + 标量缩放），
// 不含任何算法语义。
// ─────────────────────────────────────────────────────────────────────────

#version 450

layout(local_size_x = 16, local_size_y = 16) in;

layout(std430, binding = 0) readonly buffer  BufferA { float A[]; };
layout(std430, binding = 1) readonly buffer  BufferB { float B[]; };
layout(std430, binding = 2) writeonly buffer BufferC { float C[]; };

// Push constants：单 batch 逻辑维度 + 转置标志 + 输出缩放（batch 步长可推导）
layout(push_constant) uniform PushConstants {
    uint M;      // 每个 batch 的输出行数
    uint N;      // 每个 batch 的输出列数
    uint K;      // 收缩维度
    uint transA; // 1 = A_b 存储为 (K,M)，按 A_b^T 使用
    uint transB; // 1 = B_b 存储为 (N,K)，按 B_b^T 使用
    float alpha; // 输出缩放系数：C_b = alpha * op(A_b, B_b)
};

// 分块维度常量
const uint BM = 64u;  // 输出块行数
const uint BN = 64u;  // 输出块列数
const uint BK = 16u;  // K 维度分块宽度

// Shared Memory：Padding 避免 Bank Conflict
shared float tileA[64][17];
shared float tileB[16][65];

// ── 访问 A_b 元素（batch b 由 gl_GlobalInvocationID.z 给出） ──────────
// batch 偏移 = b * M * K（无论 transA，A 的 batch 步长都是 M*K）
float getA(uint b, uint m, uint k) {
    const uint base = b * M * K;
    return (transA != 0u) ? A[base + k * M + m] : A[base + m * K + k];
}

// ── 访问 B_b 元素 ─────────────────────────────────────────────────────
// batch 偏移 = b * K * N
float getB(uint b, uint k, uint n) {
    const uint base = b * K * N;
    return (transB != 0u) ? B[base + n * K + k] : B[base + k * N + n];
}

void main()
{
    const uint tx = gl_LocalInvocationID.x;   // 0..15
    const uint ty = gl_LocalInvocationID.y;   // 0..15
    const uint tid = ty * 16u + tx;           // 线性线程 ID 0..255
    const uint b = gl_GlobalInvocationID.z;   // batch 索引

    // 当前 WorkGroup 负责的 batch 内输出块起始坐标
    const uint block_row = gl_WorkGroupID.y * BM;
    const uint block_col = gl_WorkGroupID.x * BN;

    // ── 寄存器分块：4×4 累加器 ──────────────────────────────────────
    float acc[4][4];
    for (uint i = 0u; i < 4u; ++i)
        for (uint j = 0u; j < 4u; ++j)
            acc[i][j] = 0.0;

    const uint num_tiles = (K + BK - 1u) / BK;

    for (uint t = 0u; t < num_tiles; ++t)
    {
        // ── 协作加载 tileA[64][16]：1024 元素，256 线程，每线程 4 元素 ──
        {
            const uint a_base_col = t * BK;
            for (uint load = 0u; load < 4u; ++load)
            {
                const uint elem = tid * 4u + load;   // 0..1023
                const uint r = elem / BK;             // 0..63
                const uint c = elem % BK;             // 0..15
                const uint gr = block_row + r;
                const uint gc = a_base_col + c;
                tileA[r][c] = (gr < M && gc < K) ? getA(b, gr, gc) : 0.0;
            }
        }

        // ── 协作加载 tileB[16][64]：1024 元素，256 线程，每线程 4 元素 ──
        {
            const uint b_base_row = t * BK;
            for (uint load = 0u; load < 4u; ++load)
            {
                const uint elem = tid * 4u + load;
                const uint r = elem / BN;             // 0..15
                const uint c = elem % BN;             // 0..63
                const uint gr = b_base_row + r;
                const uint gc = block_col + c;
                tileB[r][c] = (gr < K && gc < N) ? getB(b, gr, gc) : 0.0;
            }
        }

        barrier();

        // ── 4×4 外积累加 ────────────────────────────────────────────
        for (uint k = 0u; k < BK; ++k)
        {
            float a_vals[4];
            float b_vals[4];

            for (uint i = 0u; i < 4u; ++i)
                a_vals[i] = tileA[ty * 4u + i][k];
            for (uint j = 0u; j < 4u; ++j)
                b_vals[j] = tileB[k][tx * 4u + j];

            for (uint i = 0u; i < 4u; ++i)
                for (uint j = 0u; j < 4u; ++j)
                    acc[i][j] += a_vals[i] * b_vals[j];
        }

        barrier();
    }

    // ── 写入结果（batch 偏移 = b * M * N，含 alpha 缩放） ────────────
    const uint c_base = b * M * N;
    for (uint i = 0u; i < 4u; ++i)
    {
        const uint out_row = block_row + ty * 4u + i;
        if (out_row >= M) continue;
        for (uint j = 0u; j < 4u; ++j)
        {
            const uint out_col = block_col + tx * 4u + j;
            if (out_col >= N) continue;
            C[c_base + out_row * N + out_col] = alpha * acc[i][j];
        }
    }
}
