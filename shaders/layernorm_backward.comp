// ── layernorm_backward.comp ──────────────────────────────────────────────
// GPU LayerNorm 反向传播着色器：
//   grad_input[f][b] = (grad_out[f][b] * gamma[f] - mean_g[b] - normalized[f][b] * mean_gn[b]) * std_inv[b]
//
//   其中：
//     gy_gamma[f][b] = grad_out[f][b] * gamma[f]
//     mean_g[b]  = (1/F) * Σ_f gy_gamma[f][b]
//     mean_gn[b] = (1/F) * Σ_f gy_gamma[f][b] * normalized[f][b]
//
// 输入布局（行主序矩阵，索引 = f * cols + b）：
//   binding 0: grad_output[rows * cols]  — 上游梯度
//   binding 1: gamma[rows]               — 缩放参数
//   binding 2: normalized[rows * cols]   — 前向传播的归一化缓存
//   binding 3: std_inv[cols]             — 前向传播的标准差倒数缓存
//   binding 4: grad_input[rows * cols]   — 输出梯度
//
// Push Constants：
//   uint rows  — 特征维度（normalized_shape）
//   uint cols  — batch 维度
//
// 算法：每个 WorkGroup 处理一列（一个 batch 元素），使用 shared memory 归约。
// ─────────────────────────────────────────────────────────────────────────

#version 450

layout(local_size_x = 256) in;

layout(std430, binding = 0) readonly buffer  BufGradOut { float buf_grad_out[]; };
layout(std430, binding = 1) readonly buffer  BufGamma   { float buf_gamma[]; };
layout(std430, binding = 2) readonly buffer  BufNorm    { float buf_norm[]; };
layout(std430, binding = 3) readonly buffer  BufStdInv  { float buf_std_inv[]; };
layout(std430, binding = 4) writeonly buffer BufGradIn  { float buf_grad_in[]; };

layout(push_constant) uniform PushConstants {
    uint rows;
    uint cols;
};

shared float sdata[256];

void main()
{
    const uint tid = gl_LocalInvocationID.x;   // 0..255
    const uint col = gl_WorkGroupID.x;         // batch 元素索引
    const uint feature_count = rows;

    // ── Phase 1: 计算 mean_g = (1/F) * Σ_f grad_out[f] * gamma[f] ──
    float local_sum_g = 0.0;
    for (uint f = tid; f < feature_count; f += 256u)
    {
        local_sum_g += buf_grad_out[f * cols + col] * buf_gamma[f];
    }
    sdata[tid] = local_sum_g;
    barrier();

    // Workgroup reduction
    for (uint stride = 128u; stride > 0u; stride >>= 1u)
    {
        if (tid < stride)
            sdata[tid] += sdata[tid + stride];
        barrier();
    }

    const float mean_g = sdata[0] / float(feature_count);
    barrier();

    // ── Phase 2: 计算 mean_gn = (1/F) * Σ_f grad_out[f] * gamma[f] * normalized[f] ──
    float local_sum_gn = 0.0;
    for (uint f = tid; f < feature_count; f += 256u)
    {
        float gy_gamma = buf_grad_out[f * cols + col] * buf_gamma[f];
        local_sum_gn += gy_gamma * buf_norm[f * cols + col];
    }
    sdata[tid] = local_sum_gn;
    barrier();

    for (uint stride = 128u; stride > 0u; stride >>= 1u)
    {
        if (tid < stride)
            sdata[tid] += sdata[tid + stride];
        barrier();
    }

    const float mean_gn = sdata[0] / float(feature_count);
    barrier();

    // ── Phase 3: 计算 grad_input ─────────────────────────────────
    const float inv_std = buf_std_inv[col];
    for (uint f = tid; f < feature_count; f += 256u)
    {
        float gy_gamma = buf_grad_out[f * cols + col] * buf_gamma[f];
        float norm = buf_norm[f * cols + col];
        buf_grad_in[f * cols + col] = (gy_gamma - mean_g - norm * mean_gn) * inv_std;
    }
}
