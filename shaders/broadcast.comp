// ── broadcast.comp ────────────────────────────────────────────────────────
// 广播原语着色器（不含任何算法）
//
// 将一维向量广播到矩阵的每一行或每一列，执行逐元素二元运算。
//
// 模式：
//   mode=0: row_broadcast — A[r][c] = op(A[r][c], vec[r])
//           vec 形状 (rows, 1)，沿列方向广播
//   mode=1: col_broadcast — A[r][c] = op(A[r][c], vec[c])
//           vec 形状 (1, cols)，沿行方向广播
//
// 二元算子（op）：
//   0=Add, 1=Sub, 2=Mul, 3=Div, 4=Max, 5=Min
//
// 绑定布局：
//   binding 0: 输入 A (readonly, rows×cols)
//   binding 1: 输入 vec (readonly, rows×1 或 1×cols)
//   binding 2: 输出 OUT (writeonly, rows×cols)
//
// Push Constants：
//   uint rows — 矩阵行数
//   uint cols — 矩阵列数
//   uint mode — 0=row_broadcast, 1=col_broadcast
//   uint op   — 二元算子编号
//
// ── vec4 kernel（2026-09-24，与 DSL Row/ColBroadcast 的 vec4 路径同步）─────
// 旧版每线程 1 元素且每元素一次整数除/模求 (r, c)（flat 索引 → 行列）。
// 现镜像 DSL vec4 契约（expr_glsl_gen：RowBroadcast splat / ColBroadcast
// 4 连续 vec 元素整读）：
//   - main：base = gid*4，base >= count 返回；
//   - 快路径（count%4==0 且 cols%4==0 且 base+3 < count）：
//       cols%4==0 ⇒ 组 4 元素必在同一行且 base%4==0（行列对齐 + 16B 对齐
//       由 MemoryPool 保证）→ row: vec4(vec[r]) splat；col: vec 整读 4；
//       A/OUT vec4 整读整写。除/模每组只算一次（行/列 0）。
//   - 回退：同组 4 次标量迭代（含每元素 r=idx/cols 求值），覆盖完全一致；
//   - dispatch：ceil(count/(256*4))（backend 侧，与 elementwise 同口径）。
// ─────────────────────────────────────────────────────────────────────────

#version 450

layout(local_size_x = 256) in;

layout(std430, binding = 0) readonly buffer  BufA   { float buf_a[]; };
layout(std430, binding = 1) readonly buffer  BufVec { float buf_vec[]; };
layout(std430, binding = 2) writeonly buffer BufOut { float buf_out[]; };

// vec4 别名视图（同 binding 双声明，std430；仅对齐快路径使用）
layout(std430, binding = 0) readonly buffer  BufAv4   { vec4 buf_a4[]; };
layout(std430, binding = 1) readonly buffer  BufVecv4 { vec4 buf_vec4[]; };
layout(std430, binding = 2) writeonly buffer BufOut4  { vec4 buf_out4[]; };

layout(push_constant) uniform PushConstants {
    uint rows;
    uint cols;
    uint mode;
    uint op;
};

float apply_binary(uint op_id, float a, float b)
{
    if (op_id == 0u) return a + b;
    if (op_id == 1u) return a - b;
    if (op_id == 2u) return a * b;
    if (op_id == 3u) return a / b;
    if (op_id == 4u) return max(a, b);
    if (op_id == 5u) return min(a, b);
    return 0.0;
}

vec4 apply_binary(uint op_id, vec4 a, vec4 b)
{
    if (op_id == 0u) return a + b;
    if (op_id == 1u) return a - b;
    if (op_id == 2u) return a * b;
    if (op_id == 3u) return a / b;
    if (op_id == 4u) return max(a, b);
    if (op_id == 5u) return min(a, b);
    return vec4(0.0);
}

void main()
{
    const uint i = gl_GlobalInvocationID.x;
    const uint base = i * 4u;
    const uint total = rows * cols;
    if (base >= total) return;

    // ── 快路径：整组 4 元素同行且对齐 → vec4 ──
    if ((total & 3u) == 0u && (cols & 3u) == 0u && base + 3u < total)
    {
        const uint r = base / cols;                   // 每组一次除法
        const vec4 a = buf_a4[base >> 2];
        vec4 v;
        if (mode == 0u)
            v = vec4(buf_vec[r]);                     // row：splat
        else
        {
            const uint c0 = base % cols;              // cols%4==0 ⇒ c0%4==0
            v = buf_vec4[c0 >> 2];                    // vec 行整组 vec4 装载
        }
        buf_out4[base >> 2] = apply_binary(op, a, v);
        return;
    }

    // ── 回退：标量（每元素求行列；覆盖与快路径一致）──
    for (uint j = 0u; j < 4u; ++j)
    {
        const uint idx = base + j;
        if (idx >= total) break;
        const uint r = idx / cols;
        const uint c = idx % cols;
        const float a = buf_a[idx];
        const float v = buf_vec[(mode == 0u) ? r : c];
        buf_out[idx] = apply_binary(op, a, v);
    }
}
