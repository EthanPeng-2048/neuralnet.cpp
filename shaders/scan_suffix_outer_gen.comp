// ── scan_suffix_outer_gen.comp ───────────────────────────────────────────
// RLA 后缀扫描原语（**通用 d_k** 版本，dk 无 64 上限）：
//   d_k > 64 时后端走本 shader，S 运行态驻全局显存 scratch（B*H*dk*dk），
//   共享内存仅用于线程间同步、O(1)，对任意 dk 安全。
// 语义与 scan_suffix_outer.comp 完全一致：
//   causal=1: S_i = Σ_{t≥i,同文档} D_t（i+1 为文档起点时先清零）
//   causal=0: S_i = D_i
// D (B*H*dk², seq), X/Y (B*H*dk, seq)
// 输出 (B*H*3*dk, seq)：[0) S·X  [1) S·Y  [2) S^T·Y
// 1 workgroup/头，256 线程。性能弱于共享内存版本，优先保证正确性（任意 dk）。
// ─────────────────────────────────────────────────────────────────────────
#version 450
// -DNN_SHADER_F16=1 → f16 存储变体（Phase C2f：输入输出均 half；scratch
//   St 是引擎按 f32 分配的 R/W 中间缓冲 → 保持 float。仅需 16bit 存储）。
#if defined(NN_SHADER_F16)
#extension GL_EXT_shader_16bit_storage : require
#define NN_ETYPE float16_t
#define NN_RD(x) float(x)
// f16 写出的 RNE 舍入（同 matmul_tiled：OpFConvert 舍入未钉死，pack 按 RNE）
#include "nn_f16_rne.glsl"
#define NN_WR(w) float16_t(nn_f16_rne(w))
#else
#define NN_ETYPE float
#define NN_RD(x) (x)
#define NN_WR(x) (x)
#endif
layout(local_size_x = 256) in;

layout(std430, binding = 0) readonly  buffer BufD   { NN_ETYPE D[]; };
layout(std430, binding = 1) readonly  buffer BufX   { NN_ETYPE X[]; };
layout(std430, binding = 2) readonly  buffer BufY   { NN_ETYPE Y[]; };
layout(std430, binding = 3) readonly  buffer BufBnd { NN_ETYPE Bnd[]; };
layout(std430, binding = 4)           buffer BufSt  { float St[]; };  // R/W scratch (B*H*dk*dk)
layout(std430, binding = 5) writeonly buffer BufOut { NN_ETYPE Out[]; };

layout(push_constant) uniform Push {
    uint dk, heads, seq, causal, has_bnd, rows;
};

void main() {
    const uint bh    = gl_WorkGroupID.y;
    const uint b     = bh / heads;
    const uint r0    = bh * dk;
    const uint dbase = bh * dk * dk;
    const uint base  = bh * dk * dk;
    const uint tid   = gl_LocalInvocationID.x;

    // 初始化 S 为零
    for (uint idx = tid; idx < dk * dk; idx += 256u)
        St[base + idx] = 0.0;
    barrier();

    for (uint i = seq; i-- > 0u;) {
        if (causal == 1u) {
            uint reset = 0u;
            if (has_bnd == 1u && i + 1u < seq)
                reset = (NN_RD(Bnd[b * seq + i + 1u]) != 0.0) ? 1u : 0u;
            for (uint idx = tid; idx < dk * dk; idx += 256u) {
                const uint a = idx / dk, c = idx % dk;
                if (reset == 1u) St[base + idx] = 0.0;
                St[base + idx] += NN_RD(D[(dbase + a * dk + c) * seq + i]);
            }
        } else {
            for (uint idx = tid; idx < dk * dk; idx += 256u) {
                const uint a = idx / dk, c = idx % dk;
                St[base + idx] = NN_RD(D[(dbase + a * dk + c) * seq + i]);
            }
        }
        barrier();

        if (tid < dk) {
            float sx = 0.0, sy = 0.0, syt = 0.0;
            for (uint c = 0u; c < dk; ++c) {
                sx  += St[base + tid * dk + c] * NN_RD(X[(r0 + c) * seq + i]);
                sy  += St[base + tid * dk + c] * NN_RD(Y[(r0 + c) * seq + i]);
            }
            for (uint r = 0u; r < dk; ++r)
                syt += St[base + r * dk + tid] * NN_RD(Y[(r0 + r) * seq + i]);
            Out[(r0 + tid) * seq + i]               = NN_WR(sx);  // [0) S·X
            Out[(rows + r0 + tid) * seq + i]          = NN_WR(sy);  // [1) S·Y
            Out[(2u * rows + r0 + tid) * seq + i]     = NN_WR(syt); // [2) S^T·Y
        }
        barrier();
    }
}