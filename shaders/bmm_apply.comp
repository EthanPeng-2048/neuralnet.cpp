// ── bmm_apply.comp ────────────────────────────────────────────────────────
// 批量矩阵乘 + 行 softmax 归一化后与 V 相乘累加（M4 融合原语，两趟式注意力 Pass 2）
//
// 语义：W_b[i][j] = exp( alpha*op(A_b,B_b)[i][j] + mask[i][j] - row_max_b[i] ) / denom_b[i]
//       out_b[i][k] = Σ_j W_b[i][j] * V_b[j][k]
//   - A/B 布局与 bmm_reduce 相同；mask（可选）(M, N)，-inf 屏蔽（W=0）
//   - row_max/denom: (batch*M, 1)；V: (batch*N, D)（每 batch (N, D) 垂直堆叠）
//   - 输出：每 batch (M, D) → 堆叠 (batch*M, D)
//
// 不物化 (M, N) 权重矩阵：W 存于共享内存（N ≤ 4096），按输出列累加。
//
// Bindings：A(0), B(1), Mask(2), RowMax(3), Denom(4), V(5), Out(6)
// Push Constants：uint M, uint N, uint K, uint D, uint flags, float alpha
//   flags bit0=transA, bit1=transB, bit2=has_mask
// Dispatch：(batch*M, 1, 1)，每个工作组（256 线程）处理一行
// ─────────────────────────────────────────────────────────────────────────

#version 450

layout(local_size_x = 256) in;

layout(std430, binding = 0) readonly buffer  BufA    { float A[]; };
layout(std430, binding = 1) readonly buffer  BufB    { float B[]; };
layout(std430, binding = 2) readonly buffer  BufMask { float MASK[]; };
layout(std430, binding = 3) readonly buffer  BufM    { float MV[]; };
layout(std430, binding = 4) readonly buffer  BufL    { float LV[]; };
layout(std430, binding = 5) readonly buffer  BufV    { float VV[]; };
layout(std430, binding = 6) readonly buffer  BufDoc  { float DOC[]; };
layout(std430, binding = 7) readonly buffer  BufSlopes { float SLOPES[]; };
layout(std430, binding = 8) writeonly buffer BufOut  { float OUT[]; };

layout(push_constant) uniform PC {
    uint M;
    uint N;
    uint K;
    uint D;
    uint flags;
    uint num_heads;
    float alpha;
};

shared float w[4096];

// 组合注意力偏置：bias(b,i,j)；-inf 表示屏蔽
float biasOf(uint b, uint i, uint j)
{
    const float NEG_INF = uintBitsToFloat(0xff800000u);
    float mv = 0.0;
    if ((flags & 4u) != 0u) mv = MASK[i * N + j];
    const uint h = b % num_heads;
    const uint bs = b / num_heads;
    bool masked = ((flags & 4u) != 0u && mv == NEG_INF)
               || ((flags & 32u) != 0u && j > i)
               || ((flags & 8u) != 0u && DOC[bs * N + i] != DOC[bs * N + j]);
    if ((flags & 16u) != 0u && !masked)
        mv -= SLOPES[h] * float(int(i) - int(j));
    return masked ? NEG_INF : mv;
}

void main()
{
    const float NEG_INF = uintBitsToFloat(0xff800000u);
    const uint tid = gl_LocalInvocationID.x;
    const uint idx = gl_WorkGroupID.x;   // b*M + i
    const uint b = idx / M;
    const uint i = idx % M;
    const uint abase = b * M * K;
    const uint bbase = b * K * N;

    const bool transA = (flags & 1u) != 0u;
    const bool transB = (flags & 2u) != 0u;
    const float mval = MV[idx];
    const float inv_l = 1.0 / LV[idx];

    // ── Phase 1：计算该行所有 W_ij 存共享（256 线程分摊 N 个 j） ──
    for (uint j = tid; j < N; j += 256u)
    {
        float mv = biasOf(b, i, j);
        if (mv == NEG_INF)
        {
            w[j] = 0.0;
            continue;
        }
        float s = 0.0;
        for (uint k = 0u; k < K; ++k)
        {
            const float av = transA ? A[abase + k * M + i] : A[abase + i * K + k];
            const float bv = transB ? B[bbase + j * K + k] : B[bbase + k * N + j];
            s += av * bv;
        }
        w[j] = exp(alpha * s + mv - mval) * inv_l;
    }
    barrier();

    // ── Phase 2：O[i][d] = Σ_j w[j] * V_b[j][d] ──
    for (uint d = tid; d < D; d += 256u)
    {
        float acc = 0.0;
        for (uint j = 0u; j < N; ++j)
            acc += w[j] * VV[(b * N + j) * D + d];
        OUT[idx * D + d] = acc;
    }
}
