// ── bmm_reduce.comp ───────────────────────────────────────────────────────
// 批量矩阵乘 + 沿输出列归约（M4 融合原语，op-level 无算法语义）
//
// 语义（reduce_cols=true）：C_b[i] = reduce_j( alpha*op(A_b,B_b)[i][j] + mask[i][j] )
//   - A: (batch * a_rpb, a_cols)，B: (batch * b_rpb, b_cols)，按 batch 垂直切分
//   - 逻辑维度：M/K（A）、K/N（B），由 transA/transB 决定（与 batched_matmul 一致）
//   - mask（可选，共享）：(M, N)，对所有 batch 相同；-inf 表示屏蔽（max 天然
//     免疫，sum/min 显式跳过）；有限值作为偏置加到得分（如 ALiBi）
//   - 输出：每 batch (M, 1) → 堆叠 (batch*M, 1)
//
// 归约算子（op = flags bits 3-4）：0=Sum, 1=Max, 2=Min
// Push Constants：uint M, uint N, uint K, uint flags, float alpha
//   flags bit0=transA, bit1=transB, bit2=has_mask
// Dispatch：(batch*M, 1, 1)，每个工作组（256 线程）协作归约一行
// ─────────────────────────────────────────────────────────────────────────

#version 450

layout(local_size_x = 256) in;

layout(std430, binding = 0) readonly buffer  BufA    { float A[]; };
layout(std430, binding = 1) readonly buffer  BufB    { float B[]; };
layout(std430, binding = 2) readonly buffer  BufMask { float MASK[]; };
layout(std430, binding = 3) writeonly buffer BufOut  { float OUT[]; };

layout(push_constant) uniform PC {
    uint M;
    uint N;
    uint K;
    uint flags;
    float alpha;
};

shared float sdata[256];

void main()
{
    const float NEG_INF = uintBitsToFloat(0xff800000u);
    const uint tid = gl_LocalInvocationID.x;
    const uint idx = gl_WorkGroupID.x;   // b*M + i
    const uint b = idx / M;
    const uint i = idx % M;
    const uint abase = b * M * K;
    const uint bbase = b * K * N;

    const uint op = (flags >> 3u) & 3u;
    const bool transA = (flags & 1u) != 0u;
    const bool transB = (flags & 2u) != 0u;
    const bool has_mask = (flags & 4u) != 0u;
    const bool skip_masked = (op != 1u);   // max 对 -inf 天然免疫

    float acc = (op == 1u) ? NEG_INF
              : (op == 2u) ? -NEG_INF
              : 0.0;

    for (uint j = tid; j < N; j += 256u)
    {
        float mv = 0.0;
        if (has_mask)
        {
            mv = MASK[i * N + j];
            if (skip_masked && mv == NEG_INF) continue;
        }
        // 收缩点积
        float s = 0.0;
        for (uint k = 0u; k < K; ++k)
        {
            const float av = transA ? A[abase + k * M + i] : A[abase + i * K + k];
            const float bv = transB ? B[bbase + j * K + k] : B[bbase + k * N + j];
            s += av * bv;
        }
        s = alpha * s + mv;
        if (op == 1u) acc = max(acc, s);
        else if (op == 2u) acc = min(acc, s);
        else acc += s;
    }

    sdata[tid] = acc;
    barrier();
    for (uint st = 128u; st > 0u; st >>= 1u)
    {
        if (tid < st)
        {
            if (op == 1u) sdata[tid] = max(sdata[tid], sdata[tid + st]);
            else if (op == 2u) sdata[tid] = min(sdata[tid], sdata[tid + st]);
            else sdata[tid] += sdata[tid + st];
        }
        barrier();
    }

    if (tid == 0u) OUT[idx] = sdata[0];
}
