// ── col_softmax_denom.comp ────────────────────────────────────────────────
// M5 列式稳定 exp 和（softmax 分母等归一化统计）：
//   denom[c] = Σ_r exp( logits[r][c] - col_max[c] )
// 单 kernel 融合：工作组内先归约列 max 的 exp 再求和，不物化 (C, N) exp 张量。
//   logits: (C, N)（列主读取：每列一个工作组）
//   col_max: (1, N)（调用方先行 col_reduce_max 得到）
//   输出 denom: (1, N)
//
// Bindings：Logits(0), ColMax(1), Out(2)
// Push Constants：uint C, uint N
// Dispatch：(N, 1, 1)，每个工作组（256 线程）处理一列
// ─────────────────────────────────────────────────────────────────────────

#version 450

layout(local_size_x = 256) in;

layout(std430, binding = 0) readonly buffer  BufLogits { float LOGITS[]; };
layout(std430, binding = 1) readonly buffer  BufMax    { float MAXV[]; };
layout(std430, binding = 2) writeonly buffer BufOut    { float OUT[]; };

layout(push_constant) uniform PC {
    uint C;
    uint N;
};

shared float sdata[256];

void main()
{
    const uint tid = gl_LocalInvocationID.x;
    const uint col = gl_WorkGroupID.x;
    const float mv = MAXV[col];

    // Phase A：Σ exp(logits - col_max) 树形归约
    float acc = 0.0;
    for (uint r = tid; r < C; r += 256u)
        acc += exp(LOGITS[r * N + col] - mv);
    sdata[tid] = acc;
    barrier();
    for (uint st = 128u; st > 0u; st >>= 1u)
    {
        if (tid < st) sdata[tid] += sdata[tid + st];
        barrier();
    }
    if (tid == 0u)
        OUT[col] = sdata[0];
}
